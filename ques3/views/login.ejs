<!doctype html><html><head><meta charset="utf-8"><title>Login</title><link rel="stylesheet" href="/style.css"></head><body><main><h1>Login</h1><% if (error) { %><p class="error"><%= error %></p><% } %><% if (user) { %><p>Signed in as <%= user %></p><a href="/profile">Open profile</a><% } else { %><form method="post" action="/login"><label>Username<input name="username" required></label><label>Password<input name="password" type="password" required></label><button>Login</button></form><p>Demo: student / pass123</p><% } %></main></body></html>