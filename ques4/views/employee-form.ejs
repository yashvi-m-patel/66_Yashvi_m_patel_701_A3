<!doctype html><html><head><meta charset="utf-8"><title>Employee</title><link rel="stylesheet" href="/style.css"></head><body><main><h1><%= employee._id ? 'Edit employee' : 'Add employee' %></h1><% if (error) { %><p class="error"><%= error %></p><% } %><form method="post" action="<%= employee._id ? '/employees/' + employee._id : '/employees' %>"><label>Name<input name="name" value="<%= employee.name || '' %>" required></label><label>Email<input type="email" name="email" value="<%= employee.email || '' %>" required></label><label>Department<input name="department" value="<%= employee.department || '' %>" required></label><label>Basic salary<input type="number" min="0" step="0.01" name="basic" value="<%= employee.basic || '' %>" required></label><label>Allowance<input type="number" min="0" step="0.01" name="allowance" value="<%= employee.allowance || 0 %>" required></label><label>Deduction<input type="number" min="0" step="0.01" name="deduction" value="<%= employee.deduction || 0 %>" required></label><button>Save employee</button></form><p class="hint">Salary = basic + allowance - deduction.</p><a href="/employees">Back to employees</a></main></body></html>