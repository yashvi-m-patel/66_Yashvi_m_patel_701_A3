<!doctype html><html><head><meta charset="utf-8"><title>Employees</title><link rel="stylesheet" href="/style.css"></head><body><main class="wide"><header><div><h1>Employees</h1><p>Signed in as <%= admin %></p></div><form method="post" action="/logout"><button class="light">Logout</button></form></header><% if (message) { %><p class="success"><%= message %></p><% } %><a class="button" href="/employees/new">Add employee</a><table><thead><tr><th>Employee ID</th><th>Name</th><th>Email</th><th>Department</th><th>Salary</th><th>Actions</th></tr></thead><tbody><% employees.forEach(employee => { %><tr><td><%= employee.empId %></td><td><%= employee.name %></td><td><%= employee.email %></td><td><%= employee.department %></td><td><%= employee.salary.toFixed(2) %></td><td><a href="/employees/<%= employee._id %>/edit">Edit</a><form class="inline" method="post" action="/employees/<%= employee._id %>/delete" onsubmit="return confirm('Delete this employee?')"><button class="delete">Delete</button></form></td></tr><% }) %></tbody></table><% if (!employees.length) { %><p>No employees yet.</p><% } %></main></body></html>